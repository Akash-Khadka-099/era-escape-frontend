			<BalloonStyle>
				<text><![CDATA[<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Details</title>

  <!-- Internal CSS -->
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      padding: 20px;
    }

    .container {
      background: white;
      padding: 20px;
      border-radius: 8px;
      width: 300px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .name {
      color: darkblue;
      font-weight: bold; /* Bold */
    }

    .address {
      color: green;
      font-style: italic; /* Italic */
    }

    .phone {
      color: brown;
    }

    .age {
      color: purple;
      font-weight: bold;
    }

    .gender {
      color: darkred;
      font-style: italic;
    }
  </style>

</head>
<body>

  <div class="container" data-location-id="north_abc_homkhola">
    <p class="name">Name: John Doe</p>
    <p class="address">Address: Kathmandu, Nepal</p>
    <p class="phone">Phone: 9841234567</p>
    <p class="age">Age: 25</p>
    <p class="gender">Gender: Male</p>
  </div>

</body>
</html>
]]></text>
